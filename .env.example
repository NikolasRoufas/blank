# EG-RAG configuration (environment variables).
# Copy to `.env` and adjust. All variables are optional; defaults are shown.
# Settings are read with the EGRAG_ prefix via Pydantic Settings.

# Reproducibility
EGRAG_SEED=0
EGRAG_DETERMINISTIC=true

# Retrieval / selection budgets
EGRAG_TOP_K=5
EGRAG_SELECTION_BUDGET=5

# Generation
EGRAG_MAX_ANSWER_TOKENS=256

# Caching
EGRAG_CACHE_ENABLED=false

# Observability
EGRAG_LOG_LEVEL=INFO
