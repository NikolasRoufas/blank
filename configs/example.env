# Example EG-RAG configuration file.
# Load with:  uv run egrag inspect-config --env-file configs/example.env
# Values use the EGRAG_ prefix and override process defaults.

EGRAG_SEED=7
EGRAG_DETERMINISTIC=true
EGRAG_TOP_K=4
EGRAG_SELECTION_BUDGET=3
EGRAG_MAX_ANSWER_TOKENS=192
EGRAG_CACHE_ENABLED=false
EGRAG_LOG_LEVEL=INFO
